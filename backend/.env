# Supabase — Settings > API Keys in the Supabase dashboard
SUPABASE_URL=https://ayksawvucnxaezlpqhzr.supabase.co
# Use the SECRET key (sb_secret_...) here, not the publishable key (sb_publishable_...).
# Publishable = client-side, RLS-gated. Secret = server-side, bypasses RLS.
