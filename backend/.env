SUPABASE_JWT_SECRET=YOUR-JWT-SECRET

# Microsoft Graph (app-only auth) — Azure App Registration
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX_USER=shared-mailbox@yourdomain.com